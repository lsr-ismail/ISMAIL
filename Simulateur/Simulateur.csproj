<Project Sdk="Microsoft.NET.Sdk">

  <!-- Simulateur d'automate S7 pour l'ERP Centrale à béton (aucune dépendance externe). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SimulateurAutomate</RootNamespace>
    <AssemblyName>SimulateurAutomate</AssemblyName>
  </PropertyGroup>

</Project>
