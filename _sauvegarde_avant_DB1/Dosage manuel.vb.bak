        CreerVoyant(voyantTrapEAU, "Trap.EAU", 234, yV)
        CreerVoyant(voyantTrapMLX, "Trap.MLX", 307, yV)
        CreerVoyant(voyantMalax, "Malaxeur", 380, yV)
