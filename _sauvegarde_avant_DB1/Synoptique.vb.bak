    ' Genere le detail bascules selon le groupe actif
    Private Function DetailBascules(groupe As String) As String
        Select Case groupe.ToUpper()
            Case "GRANULATS"
                Return String.Format("AGR={0:0}kg | Cons={1:0}kg | Ecart={2:+0;-0}kg",
                    _poids_AGR, _cons_G1 + _cons_SC + _cons_SL + _cons_D2,
                    _ecar_G1 + _ecar_SC + _ecar_SL + _ecar_D2)
            Case "CIMENTS"
                Dim poseCIM As Single = If(_siloCimentActif = 1, _pose_CIM_S1, _pose_CIM_S2)
                Return String.Format("CIM={0:0}kg | Cons={1:0}kg | Ecart={2:+0;-0}kg | Silo={3}",
                    _poids_CIM, _cons_CIM, _ecar_CIM, _siloCimentActif)
            Case "EAUX"
                Return String.Format("EAU={0:0}L | Cons={1:0}L | Ecart={2:+0;-0}L",
                    _poids_EAU, _cons_EAU2, _ecar_EAU2)
            Case "ADJUVANTS"
                Return String.Format("ADJ={0:0.000}kg | Cons={1:0.000}kg | A1={2:0.000} A2={3:0.000} A3={4:0.000} A4={5:0.000}",
                    _poids_ADJ,
                    _cons_ADJ1 + _cons_ADJ2 + _cons_ADJ3 + _cons_ADJ4,
                    _pose_ADJ1, _pose_ADJ2, _pose_ADJ3, _pose_ADJ4)
            Case "MALAXEURS"
                Return String.Format("Malaxeur={0} | Cycle={1} | Gachee={2}",
                    If(_malaxeurON, "MARCHE", "ARRET"),
                    If(_cycleEnCours, "EN COURS", "ARRET"),
                    _nGachee)
            Case Else
                Return ""
        End Select
    End Function

    Private Sub AjouterPoussoir(btn As Button, adresse As String, groupe As String, nom As String)
        AddHandler btn.MouseDown, Sub(s, e)
                                      Dim ok As Boolean = False
                                      Select Case groupe.ToUpper()
                                          Case "GRANULATS" : ok = Dosage_manuel.ModeForceGranulats
                                          Case "CIMENTS" : ok = Dosage_manuel.ModeForceCiments
                                          Case "EAUX" : ok = Dosage_manuel.ModeForceEaux
                                          Case "ADJUVANTS" : ok = Dosage_manuel.ModeForceAdjuvants
                                          Case "MALAXEURS" : ok = Dosage_manuel.ModeForceMalaxeurs
                                      End Select
                                      If Not ok Then
                                          MessageBox.Show("Activez d'abord FORCAGE " & groupe & " !",
                                              "Forcage requis", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                                          Exit Sub
                                      End If
                                      _plc.Write(adresse, 1)
                                      MAJBoutonActif(CType(s, Button), True)
                                      AfficherForcage(nom & " ACTIVE")
                                      EnregistrerAction("FORCAGE", nom & " active",
                                          DetailBascules(groupe), adresse, "1", "FORCAGE")
                                  End Sub
        AddHandler btn.MouseUp, Sub(s, e)
                                    _plc.Write(adresse, 0)
                                    MAJBoutonActif(CType(s, Button), False)
                                    EnregistrerAction("FORCAGE", nom & " desactive",
                                        DetailBascules(groupe), adresse, "0", "FORCAGE")
                                End Sub
    End Sub

    Private Sub MAJBoutonActif(btn As Button, actif As Boolean)
        If btn Is Nothing OrElse Not btn.Visible Then Exit Sub
        btn.BackColor = If(actif, Color.FromArgb(100, 220, 100), Color.FromArgb(220, 220, 220))
        btn.ForeColor = If(actif, Color.White, Color.Black)
    End Sub

    Private Sub StyleBoutonMarche(btn As Button)
        If btn Is Nothing Then Exit Sub
        btn.BackColor = Color.FromArgb(100, 220, 100)
        btn.ForeColor = Color.White
        btn.FlatAppearance.BorderColor = Color.DarkGreen
    End Sub

    Private Sub StyleBoutonArret(btn As Button)
        If btn Is Nothing Then Exit Sub
        btn.BackColor = Color.FromArgb(220, 60, 60)
        btn.ForeColor = Color.White
        btn.FlatAppearance.BorderColor = Color.DarkRed
    End Sub

    Private Sub MettreAJourBoutonsCPU()
        If Not _plcConnecte Then Exit Sub
        If Not (Dosage_manuel.ModeForceGranulats OrElse Dosage_manuel.ModeForceCiments OrElse
                Dosage_manuel.ModeForceEaux OrElse Dosage_manuel.ModeForceAdjuvants OrElse
                Dosage_manuel.ModeForceMalaxeurs) Then Exit Sub
        Try
            MAJBoutonActif(Buttontr1, _etatTremie(1) = 1)
            MAJBoutonActif(Buttontr2, _etatTremie(2) = 1)
            MAJBoutonActif(Buttontr3, _etatTremie(3) = 1)
            MAJBoutonActif(Buttontr4, _etatTremie(4) = 1)
            MAJBoutonActif(Buttontpa, _etatTapis = 1)
            MAJBoutonActif(Buttontpm, _etatTapis = 0)
            MAJBoutonActif(Buttonskh, _etatSkip = 6)
            MAJBoutonActif(Buttonskb, _etatSkip = 7)
            MAJBoutonActif(Buttonska, _etatSkip = 0)
            MAJBoutonActif(Buttonsl1, _etatSilo(1) = 1)
            MAJBoutonActif(Buttonsl2, _etatSilo(2) = 1)
            MAJBoutonActif(Buttonsltr, _etatBasculeCim = 1)
            MAJBoutonActif(Buttoneau1, _etatBasculeEau = 1)
            MAJBoutonActif(Buttoneau2, _etatBasculeEau = 0)
            MAJBoutonActif(Buttoneautr, _etatBasculeEau = 1)
            MAJBoutonActif(Buttonadj1, _etatAdj(1) = 1)
            MAJBoutonActif(Buttonadj2, _etatAdj(2) = 1)
            MAJBoutonActif(Buttonadj3, _etatAdj(3) = 1)
            MAJBoutonActif(Buttonadj4, _etatAdj(4) = 1)
            MAJBoutonActif(Buttonadjtr, _etatBasculeAdj = 1)
            MAJBoutonActif(Buttonmxm, _etatMalaxeur = 1)
            MAJBoutonActif(Buttonmxa, _etatMalaxeur = 0)
        Catch : End Try
    End Sub

    Private Sub EcrirePLC(adresse As String, valeur As Boolean)
        Try
            If _plc IsNot Nothing AndAlso _plc.IsConnected Then
                _plc.Write(adresse, If(valeur, 1, 0))
            End If
        Catch ex As Exception
            Debug.WriteLine("Erreur PLC " & adresse & " : " & ex.Message)
        End Try
    End Sub

    Private Sub AfficherForcage(msg As String)
        'lblEtatPLC.Text = "FORCAGE : " & msg & "  " & DateTime.Now.ToString("HH:mm:ss")
        'lblEtatPLC.ForeColor = Color.DarkOrange
        ' lblEtatPLC.BackColor = Color.FromArgb(255, 240, 200)
        Dim t As New Timer() : t.Interval = 3000
        AddHandler t.Tick, Sub(s, e)
                               '  lblEtatPLC.Text = "PLC : OK " & DateTime.Now.ToString("HH:mm:ss")
                               ' lblEtatPLC.ForeColor = Color.Green
                               'lblEtatPLC.BackColor = Color.FromArgb(220, 255, 220)
                               t.Stop()
                           End Sub
        t.Start()
    End Sub

